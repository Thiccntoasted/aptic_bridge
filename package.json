{
  "name": "aptic_bridge",
  "version": "0.1.0",
  "private": true,
  "description": "FiveM server resource that reports a roleplay server's economy to Aptic. This file is for development and tests only; the resource itself needs no npm packages.",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/js/*.test.mjs\" \"tests/lua/*.test.mjs\"",
    "test:js": "node --test \"tests/js/*.test.mjs\"",
    "test:lua": "node --test \"tests/lua/*.test.mjs\"",
    "test:integration": "node tests/integration/e2e.integration.mjs",
    "test:integration:qbox": "node tests/integration/e2e.integration.mjs qbox",
    "test:integration:qbcore": "node tests/integration/e2e.integration.mjs qbcore",
    "test:integration:heartbeat": "node tests/integration/heartbeat.integration.mjs",
    "test:integration:upload": "node tests/integration/upload.integration.mjs",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wasmoon": "1.16.0"
  }
}
